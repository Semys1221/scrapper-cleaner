# Instantly (worker push + UI)
INSTANTLY_API_KEY=
# Optional global list (default preset only); per-preset overrides below
INSTANTLY_LIST_ID=
# INSTANTLY_LIST_ID_AVOCATS=
# INSTANTLY_LIST_ID_AGENCES_IMMOBILIERES=
INSTANTLY_READ_TIMEOUT_S=

# Outscraper (scraper worker + cleaned-lead phone enrichment)
OUTSCRAPER_API_KEY=
# Phone enrichment batch size for /emails-and-contacts and /phones-enricher (max 1000)
# OUTSCRAPER_PHONE_BATCH_SIZE=100
# Uncleaned leads stay in Supabase. Set to 1 only to restore the legacy Instantly push.
# HERCULE_ALLOW_UNCLEANED_INSTANTLY_PUSH=0
# Central leads table owned by hercule.dev. This pipeline writes rows; it does not create the table.
# HERCULE_LEADS_TABLE=leads
# Optional tuning overrides (preset defaults apply when unset)
# OUTSCRAPER_BATCH_SIZE=
# OUTSCRAPER_CONCURRENCY=
# OUTSCRAPER_LIMIT_PER_QUERY=
# OUTSCRAPER_POLL_INITIAL_S=
# OUTSCRAPER_POLL_INTERVAL_S=
# OUTSCRAPER_POLL_SLOW_S=
# OUTSCRAPER_POLL_TIMEOUT_S=
# OUTSCRAPER_TOTAL_LIMIT_BUFFER=

# Pappers / SIRENE registry gate (optional per preset)
PAPPERS_API_KEY=

# MyEmailVerifier (clean)
MYEMAILVERIFIER_API_KEY=

# Hercule Next.js API (link provision after Instantly push)
CRM_BACKEND_URL=https://www.hercule.dev
LINK_TRACKING_WEBHOOK_SECRET=
# CRON_SECRET=
# INSTANTLY_BYPASS_WEBHOOK_SECRET=

# Supabase (optional scraper / lead ingester paths)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Optional: explicit repo root (VPS / custom checkout path)
# OUTREACH_ROOT=/root/scrapper-cleaner

# Persistent scrape data (VPS default — reuses existing state/CSV under streamlit_scraper/output/)
HERCULE_DATA_ROOT=/var/lib/hercule

# VPS scrape worker control (Streamlit Scrape page + heal watchdog)
# VPS_HOST=
# VPS_USER=root
# VPS_SSH_PASSWORD=   # quote if password contains ' or @, e.g. VPS_SSH_PASSWORD="p@ss'word"
# VPS_SSH_KEY=        # optional private key path (~/.ssh/id_ed25519) instead of password
# VPS_REPO_ROOT=/root/scrapper-cleaner
# VPS_SCRAPER_SERVICE=hercule-scraper
# VPS_DISABLED=1

# Prometheus metrics exporter (optional)
# SCRAPER_EXPORTER_PORT=

# n8n — launch scrape (POST keyword, instantly_list_id, target_leads; preset_id optional)
# Preset for Suivi + n8n heal when UI omits preset_id (use avocats for list 0010fd68…, not _adhoc)
# SCRAPE_DEFAULT_PRESET=avocats
# N8N_DEFAULT_PRESET=_adhoc
# N8N_SCRAPE_WEBHOOK_URL=https://n8n.example.com/webhook/hercule-scrape
# N8N_BASE_URL=https://n8n.example.com
# N8N_API_KEY=
# N8N_VIA_VPS=0   # set 1 only if N8N_BASE_URL is empty and Mac can SSH to VPS for localhost n8n API
# N8N_VPS_LOCAL_URL=http://127.0.0.1:5678
